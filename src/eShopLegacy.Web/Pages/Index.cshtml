@page
@model eShopLegacy.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Catalog Items";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-page="/Catalog/Create" class="btn btn-primary">
            Create New
        </a>
    </p>

    <table class="table table-striped">
        <thead>
            <tr class="esh-table-header">
                <th></th>
                <th>Name</th>
                <th>Description</th>
                <th>Brand</th>
                <th>Type</th>
                <th>Price</th>
                <th>Picture name</th>
                <th>Stock</th>
                <th>Restock</th>
                <th>Max stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <img class="esh-thumbnail" src="/Pics/@item.PictureFileName" alt="@item.Name" />
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.CatalogBrand?.Brand</td>
                        <td>@item.CatalogType?.Type</td>
                        <td><span class="esh-price">@item.Price.ToString("C")</span></td>
                        <td>@item.PictureFileName</td>
                        <td>@item.AvailableStock</td>
                        <td>@item.RestockThreshold</td>
                        <td>@item.MaxStockThreshold</td>
                        <td>
                            <a asp-page="/Catalog/Edit" asp-route-id="@item.Id" class="esh-table-link">Edit</a> |
                            <a asp-page="/Catalog/Details" asp-route-id="@item.Id" class="esh-table-link">Details</a> |
                            <a asp-page="/Catalog/Delete" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center">No data was returned.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                @if (Model.ActualPage > 0)
                {
                    <a asp-page="/Index" asp-route-pageIndex="@(Model.ActualPage - 1)" asp-route-pageSize="@Model.ItemsPerPage" class="esh-pager-item esh-pager-item--navigable">
                        Previous
                    </a>
                }

                <span class="esh-pager-item">
                    Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                </span>

                @if (Model.ActualPage < Model.TotalPages - 1)
                {
                    <a asp-page="/Index" asp-route-pageIndex="@(Model.ActualPage + 1)" asp-route-pageSize="@Model.ItemsPerPage" class="esh-pager-item esh-pager-item--navigable">
                        Next
                    </a>
                }
            </nav>
        </article>
    </div>
</div>
