@page "{id:int}"
@model eShopLegacy.Web.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h2>Catalog Item Details</h2>

@if (Model.CatalogItem != null)
{
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <img src="/Pics/@Model.CatalogItem.PictureFileName" alt="@Model.CatalogItem.Name" class="img-fluid" />
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.Name</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.Description</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.Price.ToString("C")</dd>

                        <dt class="col-sm-3">Brand</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.CatalogBrand?.Brand</dd>

                        <dt class="col-sm-3">Type</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.CatalogType?.Type</dd>

                        <dt class="col-sm-3">Picture name</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.PictureFileName</dd>

                        <dt class="col-sm-3">Stock</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.AvailableStock</dd>

                        <dt class="col-sm-3">Restock</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.RestockThreshold</dd>

                        <dt class="col-sm-3">Max stock</dt>
                        <dd class="col-sm-9">@Model.CatalogItem.MaxStockThreshold</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="./Edit" asp-route-id="@Model.CatalogItem.Id" class="btn btn-primary">Edit</a>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </div>
}
else
{
    <p>Catalog item not found.</p>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}
